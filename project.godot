; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

ss2d/version="3.3.1"

[application]

config/name="Devoid Resolution"
run/main_scene="uid://bfv2v7qa227dc"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

HUD="*uid://b7r7sotyreews"

[debug]

gdscript/warnings/shadowed_variable=0
gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/mode=3
window/stretch/mode="canvas_items"
window/size/mode.editor=0

[editor_plugins]

enabled=PackedStringArray("res://addons/rmsmartshape/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://ai/": "gray",
"res://assets/": "blue",
"res://combat/": "teal",
"res://creatures/": "green",
"res://hud/": "yellow",
"res://interactable/": "orange",
"res://inventory/": "red",
"res://levels/": "pink",
"res://vfx/": "purple"
}

[gui]

theme/default_font_antialiasing=0
theme/custom_font="uid://dvg44pj43k85w"

